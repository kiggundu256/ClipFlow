# Local development only. Never commit real secrets.
DATABASE_URL="postgresql://clipflow:clipflow_dev_password@localhost:5432/clipflow?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret-before-authentication"

# Google OAuth (YouTube)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta Instagram Login
META_APP_ID=""
META_APP_SECRET=""

# Base64-encoded 32-byte key for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=""
# Private media storage directory (must be persistent and outside the public web root)
CLIPFLOW_MEDIA_DIR="./private-media"

# YouTube upload defaults. Unlisted is safest for initial testing.
YOUTUBE_DEFAULT_PRIVACY_STATUS="unlisted"
YOUTUBE_CATEGORY_ID="22"

# Keep disabled until provider adapters have been verified in your deployment.
CLIPFLOW_PUBLISHING_ENABLED="false"
# For a single-service staging deployment, start the worker alongside the web app only for controlled tests.
RUN_PUBLISHING_WORKER="false"
