# Local development only. Never commit real secrets.
DATABASE_URL="postgresql://clipflow:clipflow_dev_password@localhost:5432/clipflow?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret-before-authentication"

# Google OAuth (YouTube)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta Instagram Login
META_APP_ID=""
META_APP_SECRET=""

# Base64-encoded 32-byte key for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=""
# Private media storage directory (must be persistent and outside the public web root)
CLIPFLOW_MEDIA_DIR="./private-media"

# Keep disabled until at least one verified provider publishing adapter is implemented.
CLIPFLOW_PUBLISHING_ENABLED="false"
